# Username-ul contului TikTok care e LIVE (fără @). Cu SIMULATE=false, serverul se conectează singur la pornire.
# Contul se poate alege și din panou (cardul „TikTok LIVE”), fără să atingi fișierul ăsta.
TIKTOK_USERNAME=

# true = spectatori falși din simulator (pentru testare fără live)
# false = conectare la TikTok LIVE real la pornire (cere TIKTOK_USERNAME)
SIMULATE=true

# Opțional: cheie Euler Stream (gratuită, de pe eulerstream.com). Fără ea merge, dar cu limite mai mici
# de conectări pe zi. Nu o pune niciodată în git: stă doar în .env.
TIKTOK_SIGN_API_KEY=

# Limba jocului și a panoului: ro sau en (se poate schimba și din panou)
GAME_LANG=ro

# true = doar urmăritorii (followers) pot intra în joc (se poate schimba și din panou)
FOLLOWERS_ONLY=false

# Cu FOLLOWERS_ONLY=true: cine trimite un cadou intră oricum (true/false)
GIFTERS_BYPASS=true

# Câte caractere pot fi pe ecran deodată (20–1000); restul stau la coadă. Se schimbă și din panou.
# Pe telefon, dacă jocul se mișcă greu în timpul live-ului, scade valoarea (ex. 150).
MAX_ACTIVE=300

# Portul serverului WebSocket (jocul se conectează prin proxy-ul Vite la /ws)
SERVER_PORT=8790

# Portul paginii de joc (Vite)
GAME_PORT=5180

# true = jocul se deschide și în Wi-Fi-ul de acasă, ca aplicația de pe telefon să intre prin IP
# (ex. 192.168.1.20:5180), fără Tailscale. Legătura e necriptată, dar nu iese din casă. Panoul arată adresa.
# Nu-l porni pe un Wi-Fi public sau împărțit: panoul n-are parolă.
WIFI=false
