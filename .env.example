# Username-ul contului TikTok care e LIVE (fără @). Folosit doar când SIMULATE=false.
TIKTOK_USERNAME=

# true = spectatori falși din simulator (pentru testare fără live)
SIMULATE=true

# Limba jocului și a panoului: ro sau en (se poate schimba și din panou)
GAME_LANG=ro

# true = doar urmăritorii (followers) pot intra în joc (se poate schimba și din panou)
FOLLOWERS_ONLY=false

# Cu FOLLOWERS_ONLY=true: cine trimite un cadou intră oricum (true/false)
GIFTERS_BYPASS=true

# Portul serverului WebSocket (jocul se conectează prin proxy-ul Vite la /ws)
SERVER_PORT=8790

# Portul paginii de joc (Vite)
GAME_PORT=5180
